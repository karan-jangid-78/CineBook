# ==========================================
# CineBook Environment Configuration
# ==========================================

# Server Port (Render sets this automatically to 10000 in production)
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Database Configuration:
# - In Development/Local: Defaults to local MongoDB or embedded replica set if local is offline
# - In Production: A persistent MongoDB Atlas connection string is STRICTLY REQUIRED
# Example Atlas format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/cinebook?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/cinebook

# JWT Secret Configuration:
# - In Production: A strong, random secret is STRICTLY REQUIRED (e.g. generate via: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_EXPIRES_IN=7d

# CORS Allowed Client Origin(s) for separate frontend deployments (comma-separated if multiple):
# - For Render unified single-service deployment, leave blank or set to your Render URL
# - For decoupled Vercel deployment, set to your Vercel domain (e.g. https://cinebook.vercel.app)
CLIENT_URL=http://localhost:5173

# Seat Hold Duration in minutes
RESERVATION_HOLD_MINUTES=5

# Embedded MongoDB fallback (active in local dev only; strictly disabled in production)
USE_EMBEDDED_MONGO=true

# Optional: Auto-seed brand new databases in production without dropping data (set to 'true' only on first deploy)
AUTO_SEED=false

